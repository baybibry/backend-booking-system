{
  "ConnectionStrings": {
    "DefaultConnection": "Server=_;Database=_;User Id=_;Password=_;TrustServerCertificate=True;"
  },
  "JWT": {
    "_comment": "Minimum 32 characters required for HS256",
    "KEY": "your-secret-key-here!", 
    "ISSUER": "your-issuer-here",
    "AUDIENCE": "your-audience-here",
    "EXPIRATION": 60,
    "REFRESH_EXPIRATION_DAYS": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/booking-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "RateLimit": {
    "PermitLimit": 20,
    "WindowSeconds": 30,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}
